# Copy to .env and edit. Never commit .env.

# --- model ---
# The OpenAI-compatible endpoint the app actually talks to: vLLM in
# production (docker-compose.yml), or Ollama's own /v1 shim on a dev laptop.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen3-14B-AWQ
# Seconds to wait on a single model response.
LLM_TIMEOUT=300
# Let the model reason before answering. Slower, rarely worth it here.
LLM_THINK=false
# Most tool calls allowed while answering one question.
# One file per read plus a write adds up quickly on multi-file questions.
MAX_TOOL_STEPS=10

# --- embeddings (Step 5.1/5.2) ---
# The OpenAI-compatible endpoint app/embed.py talks to. Mirrors LLM_BASE_URL:
# a separate variable because vLLM serves one --runner per process, so chat
# and embed are always two containers even on the same box (confirmed live,
# docs/models.md -- the chat container answers /v1/embeddings with a 404).
# Production default (127.0.0.1:8001) needs no override if the embed
# container is deployed on port 8001, the same way LLM_BASE_URL's default
# already matches the chat container's port with nothing set here.
#
# [roles.embed] in models.toml is what actually turns this on; this URL
# existing is not the same claim as a container answering at it. As of 18
# September 2026 no permanent embed container is deployed -- see
# docs/plans/step-05-embeddings.md's deployment architecture section.
EMBED_BASE_URL=http://127.0.0.1:8001/v1
# A dev laptop without a local embed container may point this at the shared
# box instead: http://192.168.1.185:8001/v1 -- the same pattern
# scripts/bench_gateway.py already uses to reach the chat role off-box.
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_TIMEOUT=60

# --- Ollama, dev-only ---
# Not what the app talks to above. Only scripts/check_services.py and
# scripts/bench_models.py read these, to probe a dev laptop's Ollama install.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# --- files ---
# The one folder the assistant is allowed to read and write.
# Windows example: D:/syslab-data
# Linux example:   /home/amro/syslab-data
# A relative path is taken from the project folder, not from wherever the
# command happened to be run.
DATA_DIR=./data
# Which tenant owns this install's own documents. Every folder under DATA_DIR is
# a tenant, and this names the one that APP_TOKEN signs in as, that the gate
# scripts work as, and that scripts/migrate_to_tenants.py moved the original
# single-folder data into. Changing it after the migration points the operator's
# token at a different customer's folder, so change it before there is data, or
# not at all.
BOOTSTRAP_TENANT=default
MAX_UPLOAD_MB=50
# Where the search index lives. Kept out of DATA_DIR on purpose: it is derived
# from your files and can be deleted and rebuilt at any time.
INDEX_DIR=./index
# Where derived artifacts and the ingestion manifest live (Step 2). Same rule
# as INDEX_DIR and for the same reason: everything under here was made out of
# a file in DATA_DIR and can be deleted and rebuilt. Anything that could not be
# regenerated does not belong in it.
DERIVED_DIR=./derived
# Tenants, tokens and per-tenant database credentials. Kept apart from both
# DATA_DIR and INDEX_DIR: customer content and a disposable cache respectively.
# This one is neither, and it is the directory worth backing up.
CONTROL_DIR=./control

# --- server ---
# Keep this on 127.0.0.1 until Phase 06 adds the token check.
# Phase 06 changes it to 0.0.0.0 so Tailscale can reach it.
APP_HOST=0.0.0.0
# NOT 8000 if vLLM is on this machine: docker-compose.yml gives that port to
# vLLM, and the second thing to claim it simply fails to start.
APP_PORT=8080
# Turn this on before anything but your own tailnet can reach this server.
# It hides the interactive docs, the OpenAPI schema behind them, and the
# admin page at "/" -- three things that are harmless on a private network
# and are a published map of a file-writing API on the public internet.
PUBLIC_MODE=false

# --- the network path (Step 3.5) ---
# Cloudflare Tunnel. Both of these belong ONLY on the machine that is meant to
# be publicly reachable; a laptop that clones this repo should leave them
# blank and stays unable to publish anything by accident.
#
# COMPOSE_PROFILES is read by docker compose itself, not by the app. Setting
# it here is what makes "docker compose up -d" start the tunnel on this
# machine and not on any other -- including the run that happens after a
# reboot, which is the one a --profile flag would be forgotten on.
COMPOSE_PROFILES=
# From Cloudflare Zero Trust > Networks > Tunnels, after creating the tunnel.
# It is a credential: it authorises anything to serve traffic as that tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
# Trust CF-Connecting-IP to name the caller. Turn this on ONLY when the app is
# genuinely unreachable except through the tunnel. Behind the tunnel every
# request arrives from the cloudflared container, so with this off the login
# throttle counts the whole internet into one bucket and eight wrong guesses
# from anybody lock out everybody. With this on but the port still open,
# anyone can evade the throttle by varying one header. Off by default because
# that is the failure that is loud rather than silent.
TRUST_CLIENT_IP_HEADER=false

# --- the job lane ---
# Slow work (image generation) is queued rather than answered inline, so a
# conversation never waits behind somebody's picture. One worker is correct
# for a single GPU; raise it only if you pin jobs to a second card.
JOB_WORKERS=1
JOB_MAX_QUEUED=20
# Finished jobs stay readable this long, then are forgotten. The queue is in
# memory: jobs do not survive a restart.
JOB_RETENTION_SECONDS=1800

# --- customer database (optional) ---
# Leave DB_HOST empty and the database tools switch themselves off.
# These are somebody else's production credentials: they belong in .env, which
# is gitignored, and nowhere else. Not in code, not in a chat, not in a commit.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
# Queries are killed by the server after this many milliseconds.
DB_STATEMENT_TIMEOUT_MS=15000
# Most rows any single query may return to the model.
DB_MAX_ROWS=200
# A file has no context window, so an export gets its own, far larger ceiling.
# Conflating the two is how "save the query as a spreadsheet" would silently
# write 200 rows of a 50,000-row table.
DB_EXPORT_MAX_ROWS=100000
# An export is not an interactive query, so it is allowed far longer than one.
DB_EXPORT_TIMEOUT_MS=180000

# --- auth ---
# Generate with:  python scripts/new_token.py
# The app refuses to listen beyond this machine while this is missing or weak.
# Changing it signs out every device the next time the app restarts.
APP_TOKEN=change-me

# --- the inference plane (/v1/*) ---
# Who may spend your GPU. Comma-separated so each caller (the website, you
# testing by hand) gets its own revocable value. Deliberately NOT APP_TOKEN:
# this plane has no tenant and can reach no customer's files, and sharing a
# credential with the plane that can would throw that separation away.
# Generate each one the same way:  python scripts/new_token.py
GATEWAY_TOKENS=
# Requests per token per rolling minute.
GATEWAY_RATE_LIMIT_PER_MINUTE=60

# --- the retrieval plane (/api/v1/*) ---
# Who may ask which of a customer's documents bear on a question. Written as
# system:token pairs, comma-separated -- the SYSTEM comes from the token and
# never from a header, because a foreign tenant id only means anything inside
# one system's id space, and a caller that could name its own system could
# resolve ids in another's.
#
# The token says which system is calling; the X-Syslab-Tenant header on each
# request says which of THEIR customers. The two are joined by an operator:
#   python scripts/tenant.py alias link website 42 <our tenant id>
# An id nothing has linked answers 404, never 403.
#
# Generate each token the same way:  python scripts/new_token.py
# Empty means the retrieval plane serves nobody, which is the safe default.
RETRIEVAL_TOKENS=
