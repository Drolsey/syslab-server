# Copy to .env and edit. Never commit .env.

# --- model ---
# qwen3:8b needs roughly 8GB VRAM. Drop to qwen3:4b on a 6GB card.
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
# Seconds to wait on a single model response.
OLLAMA_TIMEOUT=300
# Let the model reason before answering. Slower, rarely worth it here.
OLLAMA_THINK=false
# Most tool calls allowed while answering one question.
# One file per read plus a write adds up quickly on multi-file questions.
MAX_TOOL_STEPS=10

# --- files ---
# The one folder the assistant is allowed to read and write.
# Windows example: D:/syslab-data
# Linux example:   /home/amro/syslab-data
DATA_DIR=./data
MAX_UPLOAD_MB=50

# --- server ---
# Keep this on 127.0.0.1 until Phase 06 adds the token check.
# Phase 06 changes it to 0.0.0.0 so Tailscale can reach it.
APP_HOST=0.0.0.0
APP_PORT=8000

# --- the job lane ---
# Slow work (image generation) is queued rather than answered inline, so a
# conversation never waits behind somebody's picture. One worker is correct
# for a single GPU; raise it only if you pin jobs to a second card.
JOB_WORKERS=1
JOB_MAX_QUEUED=20
# Finished jobs stay readable this long, then are forgotten. The queue is in
# memory: jobs do not survive a restart.
JOB_RETENTION_SECONDS=1800

# --- customer database (optional) ---
# Leave DB_HOST empty and the database tools switch themselves off.
# These are somebody else's production credentials: they belong in .env, which
# is gitignored, and nowhere else. Not in code, not in a chat, not in a commit.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
# Queries are killed by the server after this many milliseconds.
DB_STATEMENT_TIMEOUT_MS=15000
# Most rows any single query may return to the model.
DB_MAX_ROWS=200

# --- auth ---
# Generate with:  python scripts/new_token.py
# The app refuses to listen beyond this machine while this is missing or weak.
# Changing it signs out every device the next time the app restarts.
APP_TOKEN=change-me
