# The Linux half of Phase 05, kept here so the eventual move is a copy rather
# than a rewrite. Not used on Windows.
#
#   sudo cp scripts/service/syslab-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now syslab-server
#   systemctl status syslab-server
#   journalctl -u syslab-server -f
#
# Ollama's own Linux installer already creates and enables ollama.service, so
# there is no second unit to write. That is the whole Windows/Linux difference
# the plan warned about: this file, and nothing else.

[Unit]
Description=syslab-server, a local file assistant
Documentation=https://github.com/Drolsey/syslab-server
After=network-online.target ollama.service
Wants=network-online.target
# Not Requires=: if Ollama is down the app should still start and say so
# clearly, rather than refusing to run at all.
After=ollama.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/syslab-server
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/%i/syslab-server/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5s

# The app only ever needs its own folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/%i/syslab-server

[Install]
WantedBy=multi-user.target
